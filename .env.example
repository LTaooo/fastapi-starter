# 可创建 .env.<APP_ENV>（如 .env.prod）覆盖 .env 中的同名配置
APP_ENV="dev"
APP_NAME="fastapi-starter"
APP_DEBUG=true
LOG_FILE_ENABLE=true

# MySQL
mysql.enable=true
mysql.host=127.0.0.1
mysql.port=3306
mysql.user=root
mysql.password=root
mysql.db=test
mysql.echo=true

# Redis
redis.enable=true
redis.host=127.0.0.1
redis.port=6379
redis.password=
redis.db=0
redis.connection_pool=10

# rabbitmq
rabbitmq.enable=false

# mcp
mcp.enable=false

# Nacos
NACOS_ENABLE=false
NACOS_SERVER_ADDRESSES="127.0.0.1:8848"
NACOS_NAMESPACE="dev"
NACOS_GROUP="fastapi-starter"
NACOS_USERNAME="dev"
NACOS_PASSWORD="dev"
# 留空时自动获取本机 IP
NACOS_REGISTER_IP=""

# 飞书告警
feishu.enable=false
feishu.webhook=
feishu.secret=
feishu.timeout=5