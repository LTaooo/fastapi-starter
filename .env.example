# 可创建 .env.<APP_ENV>（如 .env.prod）覆盖 .env 中的同名配置
APP_ENV="dev"
APP_NAME="fastapi-starter"
APP_DEBUG=true

# 日志
log.file_enable=true
log.level=INFO
log.rotation="50 MB"
log.retention="10 days"

# MySQL
mysql.enable=true
mysql.host=127.0.0.1
mysql.port=3306
mysql.user=root
mysql.password=root
mysql.db=test
mysql.echo=true
# 连接池：大小 / 最大溢出 / 获取连接超时(秒) / 连接回收(秒，-1 不回收) / 使用前检查
mysql.pool_size=5
mysql.max_overflow=50
mysql.pool_timeout=30
mysql.pool_recycle=3600
mysql.pool_pre_ping=true

# Redis
redis.enable=true
redis.host=127.0.0.1
redis.port=6379
redis.password=
redis.db=0
redis.connection_pool=10

# rabbitmq
rabbitmq.enable=false
# rabbitmq.host=127.0.0.1
# rabbitmq.port=5672
# rabbitmq.username=test
# rabbitmq.password=test
# rabbitmq.vhost=base_vhost
# rabbitmq.prefetch=10  # 未显式指定 channel 的消费者默认预取数量

# mcp
mcp.enable=false

# Nacos
NACOS_ENABLE=false
NACOS_REGISTER_ENABLE=true
NACOS_SERVER_ADDRESSES="127.0.0.1:8848"
NACOS_NAMESPACE="dev"
NACOS_GROUP="fastapi-starter"
NACOS_USERNAME="dev"
NACOS_PASSWORD="dev"